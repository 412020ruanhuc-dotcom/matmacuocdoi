  const originalConsoleLog = console.log;
  const originalConsoleError = console.error;

    /**
   * Normalizes an error event or a promise rejection reason into a structured error object.
   * @param {*} errorEventOrReason The error object or reason.
   * @return {object} Structured error data { message, name, stack }.
   */
  function getErrorObject(errorEventOrReason) {
    if (errorEventOrReason instanceof Error) {
      return {
        message: errorEventOrReason.message,
        name: errorEventOrReason.name,
        stack: errorEventOrReason.stack,
      };
    }
    // Fallback for non-Error objects.
    try {
      return {
        message: JSON.stringify(errorEventOrReason),
        name: 'UnknownErrorType',
        stack: null,
      };
    } catch (e) {
      return {
        message: String(errorEventOrReason),
        name: 'UnknownErrorTypeNonStringifiable',
        stack: null,
      };
    }
  }

  /**
   * Converts an array of arguments (from log/error) into a single string.
   * Handles Error objects specially to include their message and stack.
   * @param {Array<*>} args - Arguments passed to console methods.
   * @return {string} A string representation of the arguments.
   */
  function stringifyArgs(args) {
    return args
      .map((arg) => {
        if (arg instanceof Error) {
          const {message, stack} = arg;
          return `Error: ${message}${stack ? ('\nStack: ' + stack) : ''}`;
        }
        if (typeof arg === 'object' && arg !== null) {
          try {
            return JSON.stringify(arg);
          } catch (error) {
            return '[Circular Object]';
          }
        } else {
          return String(arg);
        }
      })
      .join(' ');
  }

  console.log = function(...args) {
    const logString = stringifyArgs(args);
    window.parent.postMessage({ type: 'log', message: logString }, '*');
    originalConsoleLog.apply(console, args);
  };

  console.error = function(...args) {
    let errorData;
    if (args.length > 0 && args[0] instanceof Error) {
      const err = args[0];
      // If the first arg is an Error, capture its details.
      errorData = {
        type: 'error',
        source: 'CONSOLE_ERROR',
        ...getErrorObject(err),
        rawArgsString: stringifyArgs(args.slice(1)),
        timestamp: new Date().toISOString(),
      };
    } else {
      // If not an Error object, treat all args as a general error message.
      errorData = {
        type: 'error',
        source: 'CONSOLE_ERROR',
        message: stringifyArgs(args),
        name: 'ConsoleLoggedError',
        stack: null,
        timestamp: new Date().toISOString(),
      };
    }
    window.parent.postMessage(errorData, '*');
    originalConsoleError.apply(console, args);
  };

  // Listen for global unhandled synchronous errors.
  window.addEventListener('error', function(event) {
    const errorDetails = event.error ? getErrorObject(event.error) : {
      message: event.message,
      name: 'GlobalError',
      stack: null,
      filename: event.filename,
      lineno: event.lineno,
      colno: event.colno,
    };

    window.parent.postMessage({
      type: 'error',
      source: 'global',
      ...errorDetails,
      message: errorDetails.message || event.message,
      timestamp: new Date().toISOString(),
    }, '*');
  });

  // Listen for unhandled promise rejections (asynchronous errors).
  window.addEventListener('unhandledrejection', function(event) {
    const errorDetails = getErrorObject(event.reason);

    window.parent.postMessage({
      type: 'error',
      source: 'unhandledrejection',
      ...errorDetails,
      message: errorDetails.message || 'Unhandled Promise Rejection',
      timestamp: new Date().toISOString(),
    }, '*');
  });

})();</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch Ngày Tốt - Chuyên Gia Nguyễn Tuấn Anh</title>
    <!-- SỬ DỤNG DUY NHẤT PHÔNG CHỮ ROBOTO THEO YÊU CẦU -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700;900&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        /* THIẾT LẬP CHUẨN - TRIỆT TIÊU KHOẢNG ĐEN VÀ CHỐNG TRÀN */
        * { 
            box-sizing: border-box; 
            font-family: 'Roboto', sans-serif !important; 
        }
        
        body { 
            margin: 0; 
            padding: 80px 0 40px 0; 
            background: #111b27; 
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* THANH ĐIỀU HƯỚNG THÔNG MINH (ẨN KHI IN) */
        .toolbar {
            position: fixed; top: 0; left: 0; right: 0;
            background: #1e293b; padding: 15px 30px;
            display: flex; gap: 20px; justify-content: center;
            z-index: 9999; border-bottom: 3px solid #D32F2F;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }
        .btn {
            background: #D32F2F; color: white; border: none;
            padding: 10px 22px; font-size: 15px; font-weight: bold;
            border-radius: 6px; cursor: pointer; transition: 0.2s;
            display: flex; align-items: center; gap: 8px;
        }
        .btn:hover { background: #b71c1c; }
        .btn-green { background: #10b981; }
        .btn-green:hover { background: #059669; }
        .btn-orange { background: #f59e0b; }
        .btn-orange:hover { background: #d97706; }

        /* KHUNG TRÌNH CHIẾU CHUẨN 16:9 CHỐNG TRÀN TUYỆT ĐỐI */
        .slide { 
            width: 1280px; height: 720px; 
            background: #ffffff; 
            position: relative; 
            overflow: hidden; 
            page-break-after: always;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            border-radius: 4px;
            margin-bottom: 30px;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }

        /* Tiêu đề slide co gọn sát lề trên để triệt tiêu khoảng đen thừa */
        .header { 
            margin: 35px 70px 15px 70px; 
            padding-left: 18px; 
            border-left: 12px solid #D32F2F; 
            height: 60px;
            display: flex;
            align-items: center;
        }
        .title { 
            font-size: 38px; 
            font-weight: 900; 
            color: #D32F2F; 
            text-transform: uppercase; 
            line-height: 1.1;
        }
        
        .content { 
            padding: 0 70px; 
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }
        
        .huge { 
            font-size: 58px; 
            font-weight: 900; 
            color: #D32F2F; 
            margin: 0 0 20px 0; 
            line-height: 1.1;
        }
        
        /* KHUNG THÔNG TIN CỐ ĐỊNH CHIỀU CAO - CHỐNG TRÀN ĐÁY */
        .card-grid { display: flex; gap: 30px; width: 1140px; }
        .card { 
            flex: 1; 
            background: #fdfdfd; 
            padding: 25px 30px; 
            border-radius: 12px; 
            border: 2px solid #e2e8f0; 
            height: 310px; /* Cố định chiều cao an toàn */
            display: flex;
            flex-direction: column;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.02);
        }
        .card.red { border-top: 10px solid #D32F2F; }
        .card.blue { border-top: 10px solid #1976D2; }

        .label { 
            font-size: 20px; 
            font-weight: 700; 
            color: #64748b; 
            text-transform: uppercase; 
            margin-bottom: 12px; 
            display: block; 
            letter-spacing: 1px; 
        }
        .val-red { font-size: 36px; font-weight: 900; color: #D32F2F; line-height: 1.3; }
        .val-blue { font-size: 36px; font-weight: 900; color: #1976D2; line-height: 1.3; }
        
        /* Danh sách ngày kỵ */
        ul { list-style: none; font-size: 24px; line-height: 1.5; padding: 0; margin: 0; }
        li { margin-bottom: 12px; padding-left: 28px; position: relative; color: #1e293b; }
        li::before { content: "●"; color: #D32F2F; position: absolute; left: 0; font-size: 20px; }

        /* Số trang góc dưới */
        .page-num {
            position: absolute;
            bottom: 25px;
            right: 40px;
            font-size: 16px;
            color: #94a3b8;
            font-weight: bold;
        }

        /* Chế độ edit thân thiện */
        [contenteditable="true"] {
            outline: 2px dashed #10b981;
            padding: 2px 6px;
            border-radius: 4px;
            background-color: rgba(16, 185, 129, 0.03);
        }
        [contenteditable="true"]:focus {
            outline: 2px solid #10b981;
            background-color: rgba(16, 185, 129, 0.08);
        }

        /* IN / XUẤT PDF CHUẨN */
        @media print {
            .toolbar { display: none !important; }
            body { background: white; padding: 0; }
            .slide { margin: 0; box-shadow: none; border: none; border-radius: 0; page-break-after: always; }
            [contenteditable="true"] { outline: none !important; background: transparent !important; }
        }
    </style>
<style>
  .lms-source-label {
    position: absolute;
    top: 8px;
