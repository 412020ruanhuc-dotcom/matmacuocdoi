            <div class="content" style="text-align: center; justify-content: center; margin-top: 50px;">
                <h1 contenteditable="true" style="font-size: 110px; color: #D32F2F; font-weight: 900; margin: 0; line-height: 1;">XIN CẢM ƠN!</h1>
                <p contenteditable="true" style="font-size: 36px; margin-top: 25px; font-weight: 700; color: #334155;">Kính chúc Quý Vị: Thân tâm an lạc – Gia đạo bình an</p>
                <div style="width: 300px; height: 5px; background: #D32F2F; margin: 30px auto;"></div>
                <h2 contenteditable="true" style="font-size: 65px; font-weight: 900; color: #D32F2F; margin: 0; letter-spacing: 2px;">VẠN SỰ NHƯ Ý</h2>
                <div style="margin-top: 40px; display: flex; justify-content: center; gap: 40px; width: 100%;">
                    <div class="card" style="flex: none; width: 450px; height: 100px; padding: 15px; border-left: 8px solid #D32F2F;">
                        <p contenteditable="true" style="font-size: 24px; font-weight: bold; margin: 0;">Zalo: 0789.414.153 (Tuấn Anh)</p>
                    </div>
                    <div class="card" style="flex: none; width: 450px; height: 100px; padding: 15px; border-left: 8px solid #1976D2;">
                        <p contenteditable="true" style="font-size: 24px; font-weight: bold; margin: 0;">Zalo: 0849.328.628 (Nguyên Bảo)</p>
                    </div>
                </div>
            </div>
            <div class="page-num">Trang 19 / 19</div>
        </div>

    </div>

    <!-- HỆ THỐNG PHẦN MỀM THÔNG MINH - TỰ LƯU TRỮ VÀ XUẤT FILE CHUẨN ĐƯỜNG DẪN GITHUB -->
    <script>
        const STORAGE_KEY = 'tuan_anh_slide_v19';

        // Tự động khôi phục nội dung đã sửa đổi từ trình duyệt
        window.addEventListener('load', () => {
            const savedContent = localStorage.getItem(STORAGE_KEY);
            if (savedContent) {
                document.getElementById('slides-wrapper').innerHTML = savedContent;
            }
            setupAutoSave();
        });

        // Thiết lập tính năng tự động lưu mỗi khi anh nhập hoặc click ra ngoài ô sửa
        function setupAutoSave() {
            const editableElements = document.querySelectorAll('[contenteditable="true"]');
            editableElements.forEach(el => {
                el.addEventListener('blur', saveState);
                el.addEventListener('input', saveState);
            });
        }

        function saveState() {
            const wrapperHTML = document.getElementById('slides-wrapper').innerHTML;
            localStorage.setItem(STORAGE_KEY, wrapperHTML);
        }

        // Tải tệp HTML chuẩn hóa về máy
        function downloadHTML() {
            saveState(); // Đảm bảo lưu dữ liệu mới nhất trước khi tải

            // Tạm thời ẩn thanh công cụ để xuất mã nguồn HTML gốc sạch
            const toolbar = document.querySelector('.toolbar');
            toolbar.style.display = 'none';
            
            // Xây dựng cấu trúc HTML nguyên vẹn
            const htmlContent = '<!DOCTYPE html>\n<html lang="vi">\n' + document.documentElement.innerHTML + '\n</html>';
            
            toolbar.style.display = 'flex'; // Khôi phục thanh công cụ
            
            const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'lich_ngay_tot_tuan_anh_final.html'; // Tên tệp lưu chuẩn đuôi .html
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // Reset dữ liệu về bản mẫu gốc
        function resetTemplate() {
            if (confirm('Anh có chắc chắn muốn xóa toàn bộ bản nháp đang chỉnh sửa để làm lại từ đầu không?')) {
                localStorage.removeItem(STORAGE_KEY);
                location.reload();
            }
        }
    </script>

</body>
</html>
